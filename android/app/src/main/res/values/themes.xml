<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OpenScan" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorBackground">#121212</item>
        <item name="android:windowBackground">#121212</item>
        <item name="android:statusBarColor">#121212</item>
        <item name="android:navigationBarColor">#121212</item>
        <item name="android:textColor">#F2F2F2</item>
        <item name="android:textColorPrimary">#F2F2F2</item>
        <item name="android:textColorSecondary">#C8C8C8</item>
        <item name="android:colorAccent">#7EB6FF</item>
        <item name="android:colorControlActivated">#7EB6FF</item>
        <item name="android:buttonStyle">@style/OpenScanButton</item>
        <item name="android:alertDialogTheme">@android:style/Theme.Material.Dialog.Alert</item>
    </style>

    <style name="OpenScanButton" parent="@android:style/Widget.Material.Button">
        <item name="android:textColor">#F2F2F2</item>
        <item name="android:backgroundTint">#2A2A30</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="OpenScanPrimary" parent="OpenScanButton">
        <item name="android:backgroundTint">#3D8BFD</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="OpenScanQuiet" parent="OpenScanButton">
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">#B8B8C0</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">36dp</item>
    </style>

    <style name="OpenScanChip">
        <item name="android:textColor">#F4F4F5</item>
        <item name="android:textSize">13sp</item>
        <item name="android:background">@drawable/caption</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
</resources>
